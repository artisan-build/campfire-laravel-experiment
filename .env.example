# Nothing in this file is required. Laravel Cloud injects every resource's configuration (database,
# cache, queue, object storage and Reverb) and generates APP_KEY, so a Cloud environment needs no
# variables at all. These are for running Campfire outside Cloud.
APP_NAME=Campfire
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=campfire
DB_USERNAME=campfire
DB_PASSWORD=

LOG_CHANNEL=single
LOG_LEVEL=debug
